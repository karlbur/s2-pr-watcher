# LiteLLM Proxy Host IP/Domain (Nút kết nối tới LLM)
# Dùng bởi workflow trong repo đích (truyền vào script ai_review.py khi job chạy)
LITELLM_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=sk-your-litellm-master-key
AI_REVIEW_MODEL=your-model-deployment-name

# Target Repository 1
PROJ_A_NAME=backend-service
PROJ_A_URL=https://github.com/your-org/backend-service
PROJ_A_TOKEN=GH_REGISTRATION_TOKEN_HERE

# Target Repository 2
PROJ_B_NAME=frontend-app
PROJ_B_URL=https://github.com/your-org/frontend-app
PROJ_B_TOKEN=GH_REGISTRATION_TOKEN_HERE
